   "source": [
    "import numpy as np\n",
    "m = np.matrix('1 2 3 4; 5 6 7 8; 9 1 5 7')\n",
    "print(m)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "1b3a4ffd-b5e5-4d72-b2c7-e22c5d9e1aa9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[[False False  True  True]\n",
      " [ True  True  True False]\n",
      " [False False  True  True]]\n",
      "[[3 4 5 6 7 5 7]]\n"
     ]
    }
   ],
   "source": [
    "mod_m = np.logical_and(m>=3, m<=7)\n",
    "print(mod_m)\n",
    "print(m[mod_m])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "70f54fdc-73d8-4353-a72c-6feee165b919",
   "metadata": {},
