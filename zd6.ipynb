    "import numpy as np\n",
    "\n",
    "A1 = np.random.randint(1, 21, size=(3, 3))\n",
    "A2 = np.random.randint(1, 21, size=(3, 3))\n",
    "\n",
    "print(\"Матрица 1:\\n\", A1)\n",
    "print(\"Матрица 2:\\n\", A2)\n",
    "\n",
    "print(\"Сумма:\\n\", A1 + A2)\n",
    "print(\"Разность:\\n\", A1 - A2)\n",
    "print(\"Поэлементное произведение:\\n\", A1 * A2)"
   ]
  }
