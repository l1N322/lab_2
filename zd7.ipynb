   "source": [
    "import numpy as np\n",
    "\n",
    "A = np.random.randint(1, 11, size=(2, 3))\n",
    "B = np.random.randint(1, 11, size=(3, 2))\n",
    "print(\"Первая матрица:\\n\", A)\n",
    "print(\"Вторая матрица:\\n\", B)\n",
    "\n",
    "result = np.dot(A, B)\n",
    "\n",
    "print(\"Результат матричного умножения\\n\", result)"
   ]
  }
