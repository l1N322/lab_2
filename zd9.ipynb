    "import numpy as np\n",
    "\n",
    "A = np.random.randint(1, 51, size = (4, 4))\n",
    "A_t = np.transpose(A)\n",
    "A_trace = np.trace(A)\n",
    "\n",
    "print(\"Исходная матрица:\\n\", A)\n",
    "print(\"Транспонированная матрица:\\n\", A_t)\n",
    "print(\"След матрицы:\\n\", A_trace)"
   ]
  }
