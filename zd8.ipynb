   "source": [
    "import numpy as np\n",
    "\n",
    "A = np.random.rand(3, 3)\n",
    "print(\"Случайная матрица:\\n\", A)\n",
    "\n",
    "A_det = round(np.linalg.det(A), 3)\n",
    "print(\"\\nОпределитель матрицы\", A_det)\n",
    "\n",
    "if A_det == 0:\n",
    "    print(\"\\nМатрица вырождена!\")\n",
    "else:\n",
    "    A_inv = np.linalg.inv(A)\n",
    "    print(\"\\nОбратная матрица:\\n\", A_inv)"
   ]
  }
