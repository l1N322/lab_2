   "source": [
    "import numpy as np\n",
    "\n",
    "arr = np.random.randint(1, 101, size=20)\n",
    "print(f\"Исходный массив: {arr}\")\n",
    "divide_by_5 = arr[arr % 5 == 0]\n",
    "print(f\"Элементы массива, которые делятся на 5 без остатка: {divide_by_5}\")\n",
    "arr[arr % 5 == 0] = -1\n",
    "print(f\"Обновленный массив: {arr}\")"
   ]
  }
