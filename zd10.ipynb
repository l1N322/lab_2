    "import numpy as np\n",
    "\n",
    "A = np.array([[2, 3, -1],\n",
    "              [4, -1, 2],\n",
    "              [-3, 5, 4]])\n",
    "\n",
    "B = np.array([5, 6, -2])\n",
    "\n",
    "x = np.linalg.solve(A, B)\n",
    "print(\"Решение системы (x, y, z):\", x)"
   ]
  }
 ],
